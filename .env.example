# AI providers (DECISIONS.md D-001, D-017). The eval picks the primary and the fallback; see evals/results.md.
AI_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Off by default; used only when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# live (default) or saved (replay data/ai-cache only; used in tests and CI)
AI_MODE=live

# Rate limits (SPEC §10)
RATE_LIMIT_PER_10MIN=20
GLOBAL_LIVE_CHECKS_PER_DAY=500

# Added automatically by the Vercel Marketplace Upstash integration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
